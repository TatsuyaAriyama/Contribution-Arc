{
  "name": "github-contribution-rpg",
  "productName": "Contribution Arc",
  "private": true,
  "version": "0.0.0",
  "description": "A quiet developer workspace for Contribution Arc.",
  "author": "Contribution Arc",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "npm run electron:dev",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c green,blue \"vite --host localhost --port 5173 --strictPort\" \"wait-on http://localhost:5173/Contribution-Arc/ && cross-env VITE_DEV_SERVER_URL=http://localhost:5173/Contribution-Arc/ electron electron/main.mjs\"",
    "electron:build": "cross-env ELECTRON_BUILD=true CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && electron-builder --mac",
    "electron:build:win": "cross-env ELECTRON_BUILD=true npm run build && electron-builder --win"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "firebase": "^12.13.0",
    "framer-motion": "^12.39.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.contributionarc.desktop",
    "productName": "Contribution Arc",
    "copyright": "Copyright © 2026 Contribution Arc",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": null,
      "signingIdentity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "Contribution-Arc-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Contribution-Arc-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Contribution Arc",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "Contribution-Arc-${version}.${ext}"
    }
  }
}
