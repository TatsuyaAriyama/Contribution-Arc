# Cloud Functions の非機密パラメータ(defineString)。
# このファイルを functions/.env にコピーして実値を入れる。
# .env は .gitignore 済みなのでコミットされない。
#
# ── 重要 ──────────────────────────────────────────────
# シークレットキー・webhook 署名シークレットは「絶対にここに書かない」。
# それらは secret として別管理する(値は対話入力):
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# ─────────────────────────────────────────────────────

# Stripe ダッシュボードで作る price ID(機密ではない)。
# JPY / 月額 / per-seat(数量課金)の price を作って price_xxx を貼る。
STRIPE_TEAM_PRICE_ID=
# Enterprise を自己決済にしない(お問い合わせ運用)なら空のままで OK。
STRIPE_ENTERPRISE_PRICE_ID=

# Checkout 完了後・ポータル復帰先のベース URL。
APP_BASE_URL=https://tatsuyaariyama.github.io/Contribution-Arc/
