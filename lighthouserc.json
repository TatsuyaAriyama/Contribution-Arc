{
  "//": "Lighthouse CI 設定。dist を vite preview で本番と同じ /Contribution-Arc/ サブパスでサーブし、その URL を計測する（staticDistDir をルート配信すると base 付きアセットが 404 になるため）。`npm run test:lh` が事前 build を行う。",
  "ci": {
    "collect": {
      "startServerCommand": "vite preview --port 4178 --strictPort",
      "startServerReadyPattern": "Local:",
      "url": ["http://localhost:4178/Contribution-Arc/"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "budgetsPath": "./lighthouse-budget.json"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
