{
  "//": "Lighthouse CI 設定（スケルトン）。未導入: @lhci/cli。",
  "//run": "npx vite build && npx vite preview --port 4173 & npx lhci autorun",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/Contribution-Arc/"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "budgetsPath": "./lighthouse-budget.json"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
