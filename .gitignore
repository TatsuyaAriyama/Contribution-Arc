node_modules
dist
release
.DS_Store
*.local

# Environment files — never commit secrets. The example template is
# safe to share (it has no real values) so it stays tracked.
.env
.env.*
!.env.example

# Mac App Store signing assets — these are tied to the Apple Developer
# account and must never be committed. Place them locally under build/
# before running `npm run electron:build:mas`.
build/*.provisionprofile
*.p12
*.cer

# Firebase emulator debug logs
firestore-debug.log
firebase-debug.log
ui-debug.log

# Playwright e2e artifacts
test-results
playwright-report
.playwright

# Lighthouse CI reports
.lighthouseci

# Claude Code per-session runtime lock (should not be versioned)
.claude/scheduled_tasks.lock
