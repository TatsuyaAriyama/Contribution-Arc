rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUserId(userId) {
      return userId is string
        && userId.size() >= 1
        && userId.size() <= 30
        && userId.matches('^[a-z0-9_]+(\\.[a-z0-9_]+)*$');
    }

    match /users/{uid} {
      // The user profile is the source of truth for *public* fields
      // (displayName, avatar, level, etc.) — friends/feed/search need
      // it open. Email lives on Firebase Auth, not here; the
      // `!("email" in ...)` check below is defense in depth that blocks
      // the field from being written even if client code regresses.
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && validUserId(request.resource.data.userId)
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.searchName is string
        && request.resource.data.following is list
        && !("email" in request.resource.data);
      // Update is allowed under two distinct paths:
      //   (a) Self-update: the user editing their own profile.
      //       Full validation suite applies.
      //   (b) Admin removal (Phase 8): the owner of the org the
      //       target currently belongs to may clear ONLY the three
      //       org-membership fields. They cannot reassign the user
      //       to a different org, cannot touch displayName / avatar
      //       / following, and cannot escalate roles. This is the
      //       "an employee left the company" path.
      allow update: if (
        isOwner(uid)
        && validUserId(request.resource.data.userId)
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.searchName is string
        && request.resource.data.following is list
        && !("email" in request.resource.data)
      ) || (
        resource.data.organizationId is string
        && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["organizationId", "organizationName", "organizationRole"])
        && request.resource.data.organizationId == null
      ) || (
        // Phase 9: org owner sets / clears the member's team label.
        // Only the `teamName` field may change on this path — no
        // other user-doc field can be piggy-backed, so this cannot
        // be abused to flip roles or rewrite display names.
        resource.data.organizationId is string
        && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["teamName"])
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() <= 40
      ) || (
        // 組織作成フロー (createOrganization の 2 番目の書き込み):
        // ユーザーが「自分が作成した org」に自分のメンバーシップ
        // (organizationId / organizationName / organizationRole) を
        // 付与する。アタッチ先 org の ownerUid == 自分 を get() で
        // 確認するので、他人の org には参加できない（権限昇格不可）。
        // プロフィール項目 (searchName / following 等) の完全性に
        // 依存しないため、旧データのユーザーでも組織を作成できる。
        isOwner(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["organizationId", "organizationName", "organizationRole"])
        && request.resource.data.organizationId is string
        && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerUid == request.auth.uid
      );
      // Phase 8: self-delete is required for 個人情報保護法 / GDPR
      // data-subject deletion rights. The client is responsible for
      // cascading the user's own posts / logs / etc. before calling
      // this — but each of those collections already restricts
      // delete to the owner, so a user can fully erase themselves
      // from the client without admin intervention.
      allow delete: if isOwner(uid);
    }

    match /usernames/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validUserId(userId)
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /workspaceRooms/{roomId} {
      allow read: if signedIn();
      // Bind createdBy to the requester so attackers can't seed rooms
      // attributed to other users and abuse the createdBy-based update/
      // delete checks below.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string;
      allow update: if signedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string;
      allow update: if signedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.name is string;
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /studyLogs/{logId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.category is string
        && request.resource.data.studyMinutes is number
        && request.resource.data.earnedExp is number;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /workspaceSessions/{sessionId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.currentTask is string
        && request.resource.data.durationMinutes is number
        && request.resource.data.earnedExp is number;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /achievements/{achievementId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /githubActivities/{activityId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.githubId is string;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.username is string
        && request.resource.data.createdAt is string
        && request.resource.data.likesCount is number
        && request.resource.data.likedUserIds is list;
      // Like / unlike: the only mutation allowed on someone else's post.
      // We constrain the requester to toggling *their own* uid in
      // likedUserIds, and require likesCount to move in lockstep (±1).
      // We don't assert likesCount == size(list) absolutely — legacy
      // docs may have drifted and we don't want to lock likes on them.
      allow update: if signedIn()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["likedUserIds", "likesCount", "updatedAt"])
        && request.resource.data.likesCount is number
        && request.resource.data.likedUserIds is list
        && (
          // Like: requester adds their own uid; count moves +1 in lockstep.
          (request.resource.data.likedUserIds.size() == resource.data.likedUserIds.size() + 1
            && request.resource.data.likesCount == resource.data.likesCount + 1
            && request.auth.uid in request.resource.data.likedUserIds
            && !(request.auth.uid in resource.data.likedUserIds))
          ||
          // Unlike: requester removes their own uid; count moves -1 in lockstep.
          (request.resource.data.likedUserIds.size() == resource.data.likedUserIds.size() - 1
            && request.resource.data.likesCount == resource.data.likesCount - 1
            && !(request.auth.uid in request.resource.data.likedUserIds)
            && request.auth.uid in resource.data.likedUserIds)
        );
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.postId == postId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 160
          && request.resource.data.username is string
          && request.resource.data.createdAt is string;
        allow update: if false;
        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    match /dailyReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.plan is string
        && request.resource.data.reflection is string;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.plan is string
        && request.resource.data.reflection is string;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /learningItems/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.color is string;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /workspaceRecruitments/{recruitmentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.task is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 140
        && request.resource.data.durationMinutes is number
        && request.resource.data.createdAt is string
        && request.resource.data.startAt is string
        && request.resource.data.expiresAt is string
        && request.resource.data.joinedUserIds is list;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.joinedUserIds is list;
      // Join / leave: any signed-in user may flip their *own* uid in
      // joinedUserIds. They cannot add/remove someone else, cannot wipe
      // the list, and cannot edit any other field on the recruitment.
      allow update: if signedIn()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["joinedUserIds", "updatedAt"])
        && request.resource.data.joinedUserIds is list
        && (
          (request.resource.data.joinedUserIds.size() == resource.data.joinedUserIds.size() + 1
            && request.auth.uid in request.resource.data.joinedUserIds
            && !(request.auth.uid in resource.data.joinedUserIds))
          ||
          (request.resource.data.joinedUserIds.size() == resource.data.joinedUserIds.size() - 1
            && !(request.auth.uid in request.resource.data.joinedUserIds)
            && request.auth.uid in resource.data.joinedUserIds)
        );
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // IAP レシート検証で書き込まれる重複防止レコード。
    // クライアントからの読み書きは一切禁止し、Cloud Functions
    // (admin SDK) のみがアクセスできる。admin SDK はルールを
    // バイパスするので、明示的に deny しておくのが安全。
    match /processedTransactions/{transactionId} {
      allow read, write: if false;
    }

    // B2B 組織テナント。Phase 1 MVP では「作成者 == オーナー」のみ
    // 更新可能とし、メンバー一覧は users コレクションの
    // organizationId フィールドを query して再構成する。SCIM /
    // メンバー管理 / 役割変更などは後のフェーズで Cloud Functions
    // 経由に切り出す前提。
    match /organizations/{orgId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      // 現オーナーのみ更新可能。ownerUid 自体の書き換え
      // （オーナー譲渡）も許可するが、新オーナーが「同じ org の
      // 現メンバー」であることを users/{newOwnerUid} の
      // organizationId を get() して確認する。同一オーナーへの
      // 上書き（譲渡なし）は new == old の判定で常に通る。
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid is string
        && (
          request.resource.data.ownerUid == resource.data.ownerUid
          || get(/databases/$(database)/documents/users/$(request.resource.data.ownerUid)).data.organizationId == orgId
        )
        // 課金フィールドはサーバ（Stripe webhook を受ける Cloud Function /
        // admin SDK）専用。admin SDK はルールをバイパスするので、ここで
        // クライアントからの書き換えを禁止しておくことで「UI からの自己
        // アップグレード」を塞ぐ。planTier / stripeCustomerId /
        // stripeSubscriptionId は client から変更不可。
        && !request.resource.data.diff(resource.data).changedKeys()
              .hasAny(["planTier", "stripeCustomerId", "stripeSubscriptionId"]);
      // 削除はオーナーのみ。Phase 1 MVP では UI から呼んでいないが
      // 将来の管理画面のために許可しておく。
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // 招待トークン。ドキュメント ID 自体がランダム UUID の "secret"
    // なので、推測困難。誰でも read できるのは、招待リンクを踏んだ
    // ユーザーが accept フローで自分のドキュメントを読めるように
    // するため。書き込みは作成者のみ、もしくは「自分の uid を
    // usedBy に追加する」更新のみ許可。
    match /organizationInvites/{token} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.orgId is string
        && request.resource.data.orgName is string
        && request.resource.data.expiresAt is string
        && request.resource.data.maxUses is number
        && request.resource.data.usedBy is list;
      // 招待を消費する更新: 自分の uid を usedBy に 1 件だけ追加。
      // それ以外のフィールドは変更不可。`hasOnly(["usedBy"])` で
      // 他フィールドの書き換えを禁止し、配列の差分は ±1、追加した
      // 要素は自分の uid 限定、で固める。
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["usedBy"])
        && request.resource.data.usedBy is list
        && request.resource.data.usedBy.size() == resource.data.usedBy.size() + 1
        && request.auth.uid in request.resource.data.usedBy
        && !(request.auth.uid in resource.data.usedBy);
      // 招待の削除はオーナー（招待発行者）のみ。
      allow delete: if signedIn()
        && resource.data.invitedBy == request.auth.uid;
    }

    // 監査ログ（Phase 5）。Org 単位のイベント履歴。
    // - read: 同じ org に属するメンバーのみ。クライアント側の
    //   admin ダッシュボードで一覧表示する用途。
    //   ※ ここでは orgId 一致のみチェックし、users/{uid} の
    //   organizationId フィールドを引き合わせる get() で
    //   メンバーシップを確認している。
    // - create: 自分が actor として記録する分に限り許可。
    //   actorUid == 自分、orgId は自分の所属する組織のみ。
    // - update/delete: 改ざん禁止。完全な追記専用台帳とする。
    match /auditLogs/{logId} {
      allow read: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == resource.data.orgId;
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.orgId is string
        && request.resource.data.type is string
        && request.resource.data.target is string
        && request.resource.data.createdAt is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == request.resource.data.orgId;
      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.status == "pending";
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }
  }
}
