rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUserId(userId) {
      return userId is string
        && userId.size() >= 1
        && userId.size() <= 30
        && userId.matches('^[a-z0-9_]+(\\.[a-z0-9_]+)*$');
    }

    match /users/{uid} {
      // The user profile is the source of truth for *public* fields
      // (displayName, avatar, level, etc.) — friends/feed/search need
      // it open. Email lives on Firebase Auth, not here; the
      // `!("email" in ...)` check below is defense in depth that blocks
      // the field from being written even if client code regresses.
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && validUserId(request.resource.data.userId)
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.searchName is string
        && request.resource.data.following is list
        && !("email" in request.resource.data);
      allow delete: if false;
    }

    match /usernames/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validUserId(userId)
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /workspaceRooms/{roomId} {
      allow read: if signedIn();
      // Bind createdBy to the requester so attackers can't seed rooms
      // attributed to other users and abuse the createdBy-based update/
      // delete checks below.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string;
      allow update: if signedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string;
      allow update: if signedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.name is string;
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /studyLogs/{logId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.category is string
        && request.resource.data.studyMinutes is number
        && request.resource.data.earnedExp is number;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /workspaceSessions/{sessionId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.currentTask is string
        && request.resource.data.durationMinutes is number
        && request.resource.data.earnedExp is number;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /achievements/{achievementId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /githubActivities/{activityId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.githubId is string;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.username is string
        && request.resource.data.createdAt is string
        && request.resource.data.likesCount is number
        && request.resource.data.likedUserIds is list;
      // Like / unlike: the only mutation allowed on someone else's post.
      // We constrain the requester to toggling *their own* uid in
      // likedUserIds, and require likesCount to move in lockstep (±1).
      // We don't assert likesCount == size(list) absolutely — legacy
      // docs may have drifted and we don't want to lock likes on them.
      allow update: if signedIn()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["likedUserIds", "likesCount", "updatedAt"])
        && request.resource.data.likesCount is number
        && request.resource.data.likedUserIds is list
        && (
          // Like: requester adds their own uid; count moves +1 in lockstep.
          (request.resource.data.likedUserIds.size() == resource.data.likedUserIds.size() + 1
            && request.resource.data.likesCount == resource.data.likesCount + 1
            && request.auth.uid in request.resource.data.likedUserIds
            && !(request.auth.uid in resource.data.likedUserIds))
          ||
          // Unlike: requester removes their own uid; count moves -1 in lockstep.
          (request.resource.data.likedUserIds.size() == resource.data.likedUserIds.size() - 1
            && request.resource.data.likesCount == resource.data.likesCount - 1
            && !(request.auth.uid in request.resource.data.likedUserIds)
            && request.auth.uid in resource.data.likedUserIds)
        );
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.postId == postId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 160
          && request.resource.data.username is string
          && request.resource.data.createdAt is string;
        allow update: if false;
        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    match /dailyReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.plan is string
        && request.resource.data.reflection is string;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.plan is string
        && request.resource.data.reflection is string;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /learningItems/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.color is string;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /workspaceRecruitments/{recruitmentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.task is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 140
        && request.resource.data.durationMinutes is number
        && request.resource.data.createdAt is string
        && request.resource.data.startAt is string
        && request.resource.data.expiresAt is string
        && request.resource.data.joinedUserIds is list;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.joinedUserIds is list;
      // Join / leave: any signed-in user may flip their *own* uid in
      // joinedUserIds. They cannot add/remove someone else, cannot wipe
      // the list, and cannot edit any other field on the recruitment.
      allow update: if signedIn()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["joinedUserIds", "updatedAt"])
        && request.resource.data.joinedUserIds is list
        && (
          (request.resource.data.joinedUserIds.size() == resource.data.joinedUserIds.size() + 1
            && request.auth.uid in request.resource.data.joinedUserIds
            && !(request.auth.uid in resource.data.joinedUserIds))
          ||
          (request.resource.data.joinedUserIds.size() == resource.data.joinedUserIds.size() - 1
            && !(request.auth.uid in request.resource.data.joinedUserIds)
            && request.auth.uid in resource.data.joinedUserIds)
        );
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // IAP レシート検証で書き込まれる重複防止レコード。
    // クライアントからの読み書きは一切禁止し、Cloud Functions
    // (admin SDK) のみがアクセスできる。admin SDK はルールを
    // バイパスするので、明示的に deny しておくのが安全。
    match /processedTransactions/{transactionId} {
      allow read, write: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.status == "pending";
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }
  }
}
